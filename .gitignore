# ===== managed by fix-gitignore script =====
# local deploy scripts (machine paths / credential risk)
*.bat
*.ps1
*.cmd
*.lnk
*.hta
*.vbs

# backup & temp
*.bak
*.bak-*
*.bak.*
*.tmp
*.old
*.orig
*.rej
*~

# editor / os
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# deps / cache
node_modules/
npm-cache/
__pycache__/
*.pyc
.venv/
venv/
pip-*/
uv-cache/
.uv-cache/

# logs
*.log
err*.txt
_repo.txt

# secrets - never commit
.env
.env.*
*.pem
*.key
*token*.txt
