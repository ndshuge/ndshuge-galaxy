*.pyc
.venv/
venv/
pip-*/
uv-cache/
.uv-cache/

# ===== 日志 =====
*.log
err*.txt
_repo.txt

# ===== 密钥类，永不入库 =====
.env
.env.*
*.pem
*.key
*token*.txt
*令牌*.txt

